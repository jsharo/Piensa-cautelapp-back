// Prisma 5/7 compatible schema
// Esquema integrado: RBAC funcional + SharedGroups + Requisitos de Tesis (CCAM)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario         Int      @id @default(autoincrement())
  nombre             String
  email              String   @unique
  email_recuperacion String?  @unique // Email secundario para recuperación de contraseña
  contrasena         String
  imagen             String?  // Opcional
  fcm_token          String?  // Token FCM para notificaciones push en segundo plano
  token_version      Int      @default(0)

  // FK Rol (Mantiene tu sistema RBAC original)
  id_rol             Int
  rol                Roles    @relation(fields: [id_rol], references: [id_rol])

  // Relaciones
  usuariosAdultoMayor    UsuarioAdultoMayor[]
  sharedGroupMemberships SharedGroupMember[]
  alertasAtendidas       Notificaciones[] @relation("AlertasAtendidas")
  sesiones               Sesion[]

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("Usuario")
}

model AdultoMayor {
  id_adulto          Int      @id @default(autoincrement())
  nombre             String
  fecha_nacimiento   DateTime
  direccion          String

  // NUEVO: Agregado por los resultados de las encuestas del CCAM (Medicina y Psicología)
  antecedentes_medicos String? // Enfermedades base y medicamentos de alerta
  notas_psicologicas   String? // Notas clave sobre cómo tranquilizar o tratar a la persona en crisis

  // FK a Dispositivo
  id_dispositivo     String?  @unique
  dispositivo        Dispositivo? @relation(fields: [id_dispositivo], references: [id_dispositivo])

  notificaciones      Notificaciones[]
  usuariosAdultoMayor UsuarioAdultoMayor[]
  sharedInGroups      SharedGroupDevice[] // Grupos que tienen acceso a este dispositivo

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("AdultoMayor")
}

model Dispositivo {
  id_dispositivo String    @id // ID del dispositivo enviado por ESP32 (ej: "ESP32_PULSERA_01")
  online_status  Boolean   @default(false) // Estado de conexión online/offline
  last_seen      DateTime? // Última vez que se conectó

  adulto         AdultoMayor?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("Dispositivo")
}

model Notificaciones {
  id_notificacion Int      @id @default(autoincrement())
  id_adulto       Int
  adulto          AdultoMayor @relation(fields: [id_adulto], references: [id_adulto])

  tipo            String   // Ej: "FALL_DETECTED", "BOTON_PANICO", "HEART_RATE_ABNORMAL"
  fecha_hora      DateTime @default(now())
  pulso           Int?     // Frecuencia cardíaca (BPM) en el momento del evento
  spo2            Int?     // NUEVO: Oxigenación en sangre capturada por el MAX30102
  mensaje         String?  // Descripción del evento

  // NUEVO: Control de estado y auditoría para las acciones de la app móvil
  estado          String   @default("PENDING") // PENDING (Pendiente), EN_ROUTE (Voy en camino), RESOLVED (Atendida)
  atendido_by_id  Int?     // FK a Usuario que atendió o tomó la alerta
  atendido_por    Usuario? @relation("AlertasAtendidas", fields: [atendido_by_id], references: [id_usuario])
  nota_atencion   String?  // Nota escrita por el cuidador sobre lo ocurrido
  atendida_at     DateTime? // Hora exacta en que se marcó como atendida

  @@map("Notificaciones")
}

model Roles {
  id_rol      Int     @id @default(autoincrement())
  nombre_rol  String
  descripcion String?

  usuarios    Usuario[]
  rolesPermisos RolesPermisos[]

  @@map("Roles")
}

model Permisos {
  id_permiso     Int    @id @default(autoincrement())
  nombre_permiso String
  descripcion    String?

  rolesPermisos RolesPermisos[]

  @@map("Permisos")
}

model RolesPermisos {
  id_rol     Int
  id_permiso Int

  rol     Roles    @relation(fields: [id_rol], references: [id_rol])
  permiso Permisos @relation(fields: [id_permiso], references: [id_permiso])

  @@id([id_rol, id_permiso])
  @@map("RolesPermisos")
}

model UsuarioAdultoMayor {
  id_usuario Int
  id_adulto  Int

  usuario Usuario     @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  adulto  AdultoMayor @relation(fields: [id_adulto], references: [id_adulto], onDelete: Cascade)

  @@id([id_usuario, id_adulto])
  @@map("Usuario-AdultoMayor")
}

model PasswordReset {
  email     String   @id
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)

  @@map("PasswordReset")
}

model Sesion {
  id                String    @id @default(uuid())
  id_usuario        Int
  clave_dispositivo String
  recordar          Boolean   @default(false)
  expira_en         DateTime
  revocada_en       DateTime?
  ultimo_acceso     DateTime  @default(now())
  created_at        DateTime  @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@unique([id_usuario, clave_dispositivo])
  @@index([id_usuario, revocada_en])
  @@map("Sesion")
}

// --- GESTIÓN DE GRUPOS COMPARTIDOS (Se mantiene intacto y funcional) ---
model SharedGroup {
  id            Int      @id @default(autoincrement())
  name          String?
  code          String   @unique // Código de invitación único
  created_by    Int      // FK a Usuario
  created_at    DateTime @default(now())

  members       SharedGroupMember[]
  sharedDevices SharedGroupDevice[] // Dispositivos compartidos en este grupo

  @@map("SharedGroup")
}

model SharedGroupMember {
  id         Int      @id @default(autoincrement())
  group_id   Int
  user_id    Int
  invited_by Int?     // FK a Usuario (quién invitó a este miembro)
  joined_at  DateTime @default(now())

  group      SharedGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user       Usuario     @relation(fields: [user_id], references: [id_usuario], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@map("SharedGroupMember")
}

model SharedGroupDevice {
  id         Int      @id @default(autoincrement())
  group_id   Int
  adulto_id  Int      // FK a AdultoMayor (quien tiene el dispositivo)
  shared_by  Int      // FK a Usuario (quién compartió)
  shared_at  DateTime @default(now())

  group      SharedGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  adulto     AdultoMayor @relation(fields: [adulto_id], references: [id_adulto], onDelete: Cascade)

  @@unique([group_id, adulto_id]) // Un dispositivo solo puede compartirse una vez por grupo
  @@map("SharedGroupDevice")
}